#!/usr/bin/env bash
set -euo pipefail

GREENBLUE_TOOLKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export GREENBLUE_TOOLKIT_ROOT
export GB_TOOLKIT_ROOT="$GREENBLUE_TOOLKIT_ROOT"

# shellcheck source=../lib/util.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/util.sh"
# shellcheck source=../lib/load-config.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/load-config.sh"
# shellcheck source=../lib/compose.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/compose.sh"
# shellcheck source=../lib/slots.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/slots.sh"
# shellcheck source=../lib/nginx.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/nginx.sh"
# shellcheck source=../lib/health.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/health.sh"
# shellcheck source=../lib/git-deploy.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/git-deploy.sh"
# shellcheck source=../lib/install-app.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/install-app.sh"
# shellcheck source=../lib/hev.sh
source "${GREENBLUE_TOOLKIT_ROOT}/lib/hev.sh"
# shellcheck source=../cmd/dev-up.sh
source "${GREENBLUE_TOOLKIT_ROOT}/cmd/dev-up.sh"
# shellcheck source=../cmd/deploy.sh
source "${GREENBLUE_TOOLKIT_ROOT}/cmd/deploy.sh"
# shellcheck source=../cmd/revert.sh
source "${GREENBLUE_TOOLKIT_ROOT}/cmd/revert.sh"
# shellcheck source=../cmd/status.sh
source "${GREENBLUE_TOOLKIT_ROOT}/cmd/status.sh"
# shellcheck source=../cmd/hev.sh
source "${GREENBLUE_TOOLKIT_ROOT}/cmd/hev.sh"

gb_usage() {
    cat <<EOF
Usage: gb [options] <project-root> <command> [args...]
       gb [options] <command> [args...]     when GB_PROJECT_ROOT is set

Options:
  --toolkit PATH       Path to this toolkit (default: install location)
  --hev-config PATH    host-env-vault config.toml (overrides GB_HEV_CONFIG in .greenblue)
  -h, --help           Show this help

Commands:
  deploy          Start dev stack or run prod blue-green deploy (see GB_MODE in .greenblue)
  revert          Switch host nginx back to the previous slot (prod only)
  status          Show active/previous slot from state file
  config          Print resolved settings (debug)

Environment:
  GB_PROJECT_ROOT      Default application repo when path is omitted
  GB_INSTALL_GIT_REF   Pin prod deploy to a commit SHA

Examples:
  gb /var/www/project.example.com deploy
  gb /var/www/project.example.com revert
  gb --hev-config /path/to/vault/host-config.toml /var/www/project.example.com deploy
EOF
}

gb_deprecate_command() {
    local old="$1"
    local new="$2"
    echo "gb: warning: '${old}' is deprecated; use '${new}' instead" >&2
}

gb_main() {
    local toolkit="$GREENBLUE_TOOLKIT_ROOT"
    GB_HEV_CONFIG_CLI=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h | --help)
                gb_usage
                exit 0
                ;;
            --toolkit)
                shift
                toolkit="$(gb_abs_path "${1:?}")"
                GREENBLUE_TOOLKIT_ROOT="$toolkit"
                GB_TOOLKIT_ROOT="$toolkit"
                shift
                ;;
            --hev-config)
                shift
                GB_HEV_CONFIG_CLI="$(gb_abs_path "${1:?}")"
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                gb_die "unknown option: $1"
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ $# -lt 1 ]]; then
        gb_usage >&2
        exit 1
    fi

    local project cmd
    if [[ -d "$1" && -f "$1/.greenblue" ]]; then
        project="$1"
        shift
    elif [[ -n "${GB_PROJECT_ROOT:-}" ]]; then
        project="$GB_PROJECT_ROOT"
    else
        gb_usage >&2
        exit 1
    fi

    if [[ $# -lt 1 ]]; then
        gb_usage >&2
        exit 1
    fi

    cmd="$1"
    shift

    gb_load_config "$project"

    case "$cmd" in
        deploy)
            export GB_CMD=deploy
            if [[ $# -eq 1 ]] && [[ "$1" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
                GB_INSTALL_GIT_REF="$1"
            fi
            gb_cmd_deploy "$@"
            ;;
        revert)
            export GB_CMD=revert
            gb_cmd_revert "$@"
            ;;
        status)
            export GB_CMD=status
            gb_cmd_status "$@"
            ;;
        config)
            export GB_CMD=config
            gb_config_show
            ;;
        dev-up)
            gb_deprecate_command dev-up deploy
            export GB_CMD=deploy
            gb_cmd_deploy "$@"
            ;;
        install)
            gb_deprecate_command install deploy
            export GB_CMD=deploy
            if [[ $# -eq 1 ]] && [[ "$1" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
                GB_INSTALL_GIT_REF="$1"
            fi
            gb_cmd_deploy "$@"
            ;;
        hev-sync)
            gb_deprecate_command hev-sync "deploy (HEV runs inside deploy when enabled in .greenblue)"
            export GB_CMD=hev-sync
            gb_cmd_hev_sync "$@"
            ;;
        hev-render)
            gb_deprecate_command hev-render "deploy (HEV runs inside deploy when enabled in .greenblue)"
            export GB_CMD=hev-render
            gb_cmd_hev_render "$@"
            ;;
        *)
            gb_die "unknown command: ${cmd}"
            ;;
    esac
}

gb_main "$@"
