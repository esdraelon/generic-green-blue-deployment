# Copy to ORK3/.greenblue — ORK3 uses per-color compose files and nginx color symlinks.

GB_PROJECT_NAME="ork3"
GB_CONTAINER_APP_DIR="/var/www/ork.amtgard.com"
GB_COMPOSE_SERVICE_PATTERN="ork3app-%slot%"

GB_BLUE_CONTAINER="ork3-php8-app-blue"
GB_GREEN_CONTAINER="ork3-php8-app-green"
GB_BLUE_PORT="29080"
GB_GREEN_PORT="19080"

GB_WEB_COMPOSE_BASE="docker-compose.php8-app.prod.yml"
GB_WEB_COMPOSE_SLOT="docker-compose.php8-app.%slot%"
GB_WEB_COMPOSE_DEV="docker-compose.php8-app.dev.yml"

GB_STATE_DIR="/var/lib/ork3-greenblue"

GB_NGINX_STRATEGY="ork3-color-symlink"
GB_NGINX_SITES_AVAILABLE_DIR="/etc/nginx/sites-available"
GB_NGINX_SITES_ENABLED_DEFAULT="/etc/nginx/sites-enabled/default"

GB_DEV_STACKS="web"
GB_DEPLOY_STACKS="web"

GB_APP_INSTALL="none"
GB_INSTALL_SKIP_GIT_PULL="0"

# ORK3 greenblue.sh health-checked localhost:PORT then swapped nginx; no composer in container step.
GB_HOOK_AFTER_SLOT_UP="scripts/gb-ork3-post-up.sh"
GB_HOOK_INSTALL_APP="scripts/gb-ork3-install-app.sh"
